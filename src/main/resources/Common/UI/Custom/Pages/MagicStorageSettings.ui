$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = %server.magicstorage.ui.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      $C.@CheckBoxWithLabel #AllowDeposit {
        @Text = %server.magicstorage.ui.allowDeposit;
        Anchor: (Bottom: 12);
      }

      $C.@CheckBoxWithLabel #ShowLinkedChest {
        @Text = %server.magicstorage.ui.showLinkedChest;
        Anchor: (Bottom: 16);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          Label {
            Text: %server.magicstorage.ui.chestCapacity;
            Anchor: (Bottom: 4);
            Style: $C.@DefaultLabelStyle;
          }

          $C.@NumberField #ChestCapacity {
            @Anchor = (Width: 100, Left: 0);

            Format: (MaxDecimalPlaces: 0, Step: 1, MinValue: 9, MaxValue: 90);
          }
        }
      }

      Label {
        Text: %server.magicstorage.ui.capacityHint;
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13);
      }

      Group {
        Anchor: (Vertical: 12, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #SaveButton {
        Text: %server.customUI.saveChanges;
      }
    }
  }
}

$C.@BackButton {}
